				<AvailableChannel Channel="16" Available="true" />
			</AvailableForChannels>
			<UsesControlNameList Name="CP Controles" />
			<PatchBank Name="CP Banco A (CC0=0) v2" >
				<MIDICommands>
					<ControlChange Control="0" Value="0" />
					<ControlChange Control="32" Value="0" />
				</MIDICommands>
