			<PatchBank Name="CP Banco B (CC0=1) v2" >
				<MIDICommands>
					<ControlChange Control="0" Value="1" />
					<ControlChange Control="32" Value="0" />
				</MIDICommands>
				<UsesPatchNameList Name="CP Lista B" />
			</PatchBank>
			<PatchBank Name="CP Agrupacion sin BS v2" >
				<UsesPatchNameList Name="CP Lista C" />
			</PatchBank>
			<PatchBank Name="CP BS por preset v2" >
				<UsesPatchNameList Name="CP Lista D" />
			</PatchBank>
		</ChannelNameSet>
